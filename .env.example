# Copy to .env and replace placeholders before use. Never commit .env.
POSTGRES_USER=ragvault
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=ragvault
DATABASE_URL=postgresql://ragvault:replace-with-a-strong-password@postgres:5432/ragvault
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
JWT_SECRET_KEY=replace-with-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
GROQ_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FRONTEND_URL=http://localhost:3000
# Minimum similarity (0-1) for the "Access restricted" reply. Tune against your own documents.
RESTRICTED_MATCH_MIN_SCORE=0.35
